# ---------------------------------------------------------------------------
# Backend - copy to apps/api/.env
#
# Every value here has a working default, so the file is optional. Only
# LLM_API_KEY changes behaviour: without it the app writes advice from the
# curated knowledge base instead of through the model.
# See docs/backend-architecture.md
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=4000

# Comma separated list of allowed origins for the frontend (CORS).
CORS_ORIGIN=http://localhost:5173

# ---- LLM: Tokens BD, OpenAI-compatible (optional) --------------------------
# https://tokens.bd/v1 - one call per analysis, forced tool call for JSON.
# Leave the key empty to run on the template writer; /health then reports
# llm: unconfigured.
LLM_BASE_URL=https://tokens.bd/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_TIMEOUT_MS=15000
# Provider allows 10 concurrent with a plan, 3 without.
LLM_MAX_CONCURRENCY=3

# ---- Vision: local ONNX, CPU only ------------------------------------------
# Downloads once on first use (22 MB). Covers rice and potato only: blast,
# potato early/late blight. Anything else is reported as "not identified"
# rather than guessed. Set VISION_ENABLED=false to skip inference entirely;
# results are then always marked unconfirmed.
VISION_ENABLED=true
VISION_MODEL_ID=wambugu71/crop_leaf_diseases_vit_onnx
VISION_MODEL_FILE=crop_leaf_diseases_vit.onnx
# Raw softmax probability below which the leaf is "not identified".
VISION_CONFIDENCE_THRESHOLD=0.55

# ---- TTS: local ONNX, CPU only --------------------------------------------
# Downloads once on first use (~300 MB peak RSS). Needs ffmpeg on PATH.
TTS_ENABLED=true
TTS_MODEL_ID=sulabhkatiyar/indic-tiny-tts-bengali
TTS_VOICE=female
TTS_FORMAT=opus
FFMPEG_PATH=ffmpeg

# ---- Weather: Open-Meteo free tier, no key --------------------------------
# Note: the free tier is not licensed for commercial use.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_MINUTES=30

# ---- Storage ---------------------------------------------------------------
DATABASE_PATH=./storage/foshol-lens.db
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:4000
ANALYSIS_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Frontend - copy to apps/frontend/.env.local
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
