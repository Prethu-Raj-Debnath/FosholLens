# FosholLens Environment Variables
# Copy this file to .env and fill in real values locally. NEVER commit .env.

# Google Gemini API key (used by backend/app/llm.py and optionally tts.py)
GEMINI_API_KEY=

# Frontend -> Backend API base URL (used by Vite in frontend/)
VITE_API_BASE_URL=http://localhost:8000

# Backend server port
PORT=8000
