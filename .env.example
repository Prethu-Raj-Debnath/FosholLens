# ---------------------------------------------------------------------------
# FosholLens Environment Variables
# Copy this file to .env (repo root) or apps/api/.env and fill in real values
# locally. NEVER commit .env.
#
# Every value here has a working default, so the file is optional. When neither
# GEMINI_API_KEY nor LLM_API_KEY is set, the API writes advice directly from
# the curated knowledge base (generatedBy: "template").
# See docs/backend-architecture.md
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=4000

# Comma-separated list of allowed origins for the frontend (CORS).
CORS_ORIGIN=http://localhost:5173

# ---- LLM: Google Gemini Flash (primary when configured) --------------------
# Primary key read by apps/api (LLM_API_KEY is also accepted as a Gemini key
# when LLM_PROVIDER=auto or gemini). Leave both empty to use the offline
# knowledge-base template fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional provider selector: auto (Gemini primary), gemini, or openai
LLM_PROVIDER=auto
LLM_BASE_URL=https://tokens.bd/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_TIMEOUT_MS=15000
# Provider concurrency cap.
LLM_MAX_CONCURRENCY=3

# ---- Vision: local ONNX, CPU only ------------------------------------------
# Two checkpoints, selected with VISION_MODEL:
#   efficientnet  EfficientNet-B0, 9 classes, rice + potato only. 16 MB, ~40 ms.
#                 Committed at apps/api/models/, so a fresh clone needs no setup.
#                 Covers blast, bacterial leaf blight, potato early/late blight.
#   vit           ViT-tiny, 13 classes, corn/potato/rice/wheat. 22 MB, ~140 ms.
#                 Not committed; downloaded from Hugging Face on first use.
#                 Covers blast, potato early/late blight.
# Neither is strictly better: vit can recognise crops the knowledge base has no
# advice for; efficientnet names one more disease that it does.
VISION_ENABLED=true
VISION_MODEL=efficientnet
VISION_MODEL_DIR=./models
# Raw softmax probability below which the leaf is "not identified".
VISION_CONFIDENCE_THRESHOLD=0.55

# ---- TTS: local ONNX, CPU only --------------------------------------------
# Downloads once on first use (~300 MB peak RSS). Needs ffmpeg on PATH.
TTS_ENABLED=true
TTS_MODEL_ID=sulabhkatiyar/indic-tiny-tts-bengali
TTS_VOICE=female
TTS_FORMAT=opus
FFMPEG_PATH=ffmpeg

# ---- Weather: Open-Meteo free tier, no key --------------------------------
# Note: the free tier is not licensed for commercial use.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_MINUTES=30

# ---- Storage ---------------------------------------------------------------
DATABASE_PATH=./storage/foshol-lens.db
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:4000
ANALYSIS_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Frontend - copy to apps/frontend/.env.local (optional; Vite proxies /api)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
